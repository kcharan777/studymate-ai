# OpenRouter API Key for StudyMate AI
# Get yours from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (e.g. google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Port for backend
PORT=5000
FLASK_ENV=development
